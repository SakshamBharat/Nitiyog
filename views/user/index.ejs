
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >

  <title>NitiYog — Saksham Bharat</title>

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="/css/app.css"
  >
</head>

<body>

<header class="navbar">

  <div class="brand">
    <div class="brand-logo">N</div>

    <div>
      <strong>Niti<span>yog</span></strong>

      <small>
        Saksham Bharat
      </small>
    </div>
  </div>

  <nav>

    <% if (user) { %>

      <div class="user-pill">
        <span class="user-pill-name">
          <%= user.firstName %>
        </span>

        <span class="verified-tick" aria-label="Verified user">
          ✓
        </span>
      </div>

      <a href="/dashboard">
        Dashboard
      </a>

      <button
        class="nav-button"
        onclick="logout()"
      >
        Logout
      </button>

    <% } else { %>

      <a href="/login">
        Sign in
      </a>

      <a
        href="/register"
        class="nav-primary"
      >
        Create account
      </a>

    <% } %>

  </nav>

</header>


<main>

  <section class="search-showcase">

    <div class="search-header">
      <span class="eyebrow-dark">
        Scheme discovery
      </span>

      <h2>
        Search your scheme
      </h2>
    </div>

    <p class="search-subtext">
      Describe your problem and explore government schemes that can help with
      income support, education, health, jobs, women empowerment, and more.
    </p>

    <div class="search-panel">

      <form id="schemeSearchForm" class="search-form" autocomplete="off">
        <div class="search-input-wrap">
          <input
            id="schemeSearchInput"
            type="text"
            placeholder="Search schemes, benefits, or categories"
            aria-label="Search schemes"
          >

          <button
            id="searchButton"
            type="submit"
            class="button primary"
          >
            Search
          </button>
        </div>
      </form>

      <div class="search-pills" aria-label="Scheme categories">
        <button class="filter-chip active" data-filter="all" type="button">
          All
        </button>
        <button class="filter-chip" data-filter="Agriculture" type="button">
          Agriculture
        </button>
        <button class="filter-chip" data-filter="Education" type="button">
          Education
        </button>
        <button class="filter-chip" data-filter="Healthcare" type="button">
          Healthcare
        </button>
        <button class="filter-chip" data-filter="Women" type="button">
          Women
        </button>
        <button class="filter-chip" data-filter="Employment" type="button">
          Employment
        </button>
      </div>

    </div>

    <div class="scheme-results-header">
      <h3 id="searchSummary">
        Popular schemes
      </h3>

      <span id="resultCount">
        6 schemes
      </span>
    </div>

    <div id="schemeResults" class="scheme-grid"></div>

  </section>


