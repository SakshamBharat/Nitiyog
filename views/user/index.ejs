<body>

<header class="navbar">

  <div class="brand">
    <div class="brand-logo">N</div>

    <div>
      <strong>Niti<span>yog</span></strong>

      <small>
        Saksham Bharat
      </small>
    </div>
  </div>

  <nav>

    <% if (user) { %>

      <div class="user-pill">
        <span class="user-pill-name">
          <%= user.firstName %>
        </span>

        <span class="verified-tick" aria-label="Verified user">
          ✓
        </span>
      </div>

      <a href="/dashboard">
        Dashboard
      </a>

      <button
        class="nav-button"
        onclick="logout()"
      >
        Logout
      </button>

    <% } else { %>

      <a href="/login">
        Sign in
      </a>

      <a
        href="/register"
        class="nav-primary"
      >
        Create account
      </a>

    <% } %>

  </nav>

</header>


