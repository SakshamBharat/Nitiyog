<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/nitiyog.css">
  <style>
    .admin-shell { min-height:100vh; }
    .admin-sidebar { background:var(--navy-900); padding:28px 16px; display:flex; flex-direction:column; gap:4px; position:fixed; left:0; top:0; bottom:0; width:220px; overflow-y:auto; }
    .admin-main { margin-left:220px; padding:32px 36px; }
    .page-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; }
    .page-head h1 { font-size:1.4rem; font-weight:700; }
    .filter-bar { display:flex; gap:12px; align-items:center; margin-bottom:20px; flex-wrap:wrap; }
    .filter-input { background:var(--navy-700); border:1.5px solid var(--navy-600); border-radius:8px; padding:9px 14px; color:var(--white); font-size:0.88rem; font-family:'Inter',sans-serif; outline:none; }
    .filter-input:focus { border-color:var(--gold); }
    .btn-add { background:var(--gold); color:var(--navy-900); border:none; border-radius:8px; padding:10px 20px; font-size:0.88rem; font-weight:600; cursor:pointer; text-decoration:none; display:inline-flex; align-items:center; gap:6px; font-family:'Inter',sans-serif; }
    .btn-add:hover { background:#ffb733; }
    .alert-success { background:rgba(46,204,113,0.1); border:1px solid rgba(46,204,113,0.3); color:var(--emerald); border-radius:8px; padding:12px 16px; margin-bottom:20px; font-size:0.88rem; }
    .schemes-table { width:100%; background:var(--navy-700); border:1px solid var(--navy-600); border-radius:14px; overflow:hidden; }
    .table-head { display:grid; grid-template-columns:3fr 2fr 1.5fr 1fr 1fr 1.5fr; padding:12px 20px; border-bottom:1px solid var(--navy-600); font-size:0.73rem; color:var(--grey-700); font-weight:600; text-transform:uppercase; letter-spacing:0.06em; }
    .table-row { display:grid; grid-template-columns:3fr 2fr 1.5fr 1fr 1fr 1.5fr; padding:14px 20px; border-bottom:1px solid rgba(255,255,255,0.04); align-items:center; transition:background 0.15s; }
    .table-row:hover { background:var(--navy-600); }
    .table-row:last-child { border-bottom:none; }
    .scheme-title { font-size:0.88rem; font-weight:500; color:var(--white); }
    .scheme-min { font-size:0.78rem; color:var(--grey-500); margin-top:2px; }
    .cat-chip { background:rgba(244,166,35,0.1); color:var(--gold); font-size:0.7rem; padding:2px 8px; border-radius:100px; display:inline-block; }
    .status-on  { color:var(--emerald); font-size:0.78rem; font-weight:600; }
    .status-off { color:var(--error);   font-size:0.78rem; font-weight:600; }
    .action-btns { display:flex; gap:6px; }
    .btn-edit { background:rgba(244,166,35,0.1); color:var(--gold); border:none; border-radius:6px; padding:5px 12px; font-size:0.75rem; font-weight:600; cursor:pointer; text-decoration:none; font-family:'Inter',sans-serif; }
    .btn-toggle { background:rgba(46,204,113,0.1); color:var(--emerald); border:none; border-radius:6px; padding:5px 12px; font-size:0.75rem; font-weight:600; cursor:pointer; font-family:'Inter',sans-serif; }
    .btn-del { background:rgba(255,92,92,0.1); color:var(--error); border:none; border-radius:6px; padding:5px 10px; font-size:0.75rem; font-weight:600; cursor:pointer; font-family:'Inter',sans-serif; }
    .pagination { display:flex; justify-content:center; gap:8px; margin-top:24px; }
    .pg-btn { background:var(--navy-700); border:1px solid var(--navy-600); color:var(--grey-300); padding:7px 14px; border-radius:8px; text-decoration:none; font-size:0.85rem; }
    .pg-btn.active { background:var(--gold); color:var(--navy-900); border-color:var(--gold); font-weight:600; }
    .empty-state { text-align:center; padding:60px; color:var(--grey-500); }
  </style>
</head>
<body>
<div class="admin-shell">
  <nav class="admin-sidebar">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:28px;">
      <div style="width:34px;height:34px;background:var(--gold);border-radius:10px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:0.9rem;color:var(--navy-900);">N</div>
      <div style="font-family:'Syne',sans-serif;font-weight:700;font-size:1rem;">Niti<span style="color:var(--gold);">yog</span> <span style="font-size:0.65rem;color:var(--grey-700);">ADMIN</span></div>
    </div>
    <span style="font-size:0.7rem;color:var(--grey-700);letter-spacing:0.1em;text-transform:uppercase;padding:12px 10px 6px;font-weight:600;">Panel</span>
    <a href="/admin" class="nav-item"><span class="nav-icon">📊</span> Dashboard</a>
    <a href="/admin/schemes" class="nav-item active"><span class="nav-icon">📋</span> Manage Schemes</a>
    <a href="/admin/schemes/new" class="nav-item"><span class="nav-icon">➕</span> Add Scheme</a>
    <a href="/admin/users" class="nav-item"><span class="nav-icon">👥</span> Users</a>
    <div style="margin-top:auto;padding-top:20px;border-top:1px solid var(--navy-700);">
      <a href="/logout" class="nav-item" style="color:var(--error);"><span class="nav-icon">🚪</span> Logout</a>
    </div>
  </nav>

  <main class="admin-main">
    <div class="page-head">
      <div>
        <h1>Manage Schemes</h1>
        <p style="color:var(--grey-500);font-size:0.85rem;margin-top:4px;">Add, edit, activate/deactivate government schemes</p>
      </div>
      <a href="/admin/schemes/new" class="btn-add">➕ Add New Scheme</a>
    </div>

    <% if (success) { %><div class="alert-success">✅ <%= success %></div><% } %>
    <% if (error) { %><div style="background:rgba(255,92,92,0.1);border:1px solid rgba(255,92,92,0.3);color:var(--error);border-radius:8px;padding:12px 16px;margin-bottom:20px;font-size:0.88rem;">❌ <%= error %></div><% } %>

    <!-- Filter bar -->
    <form method="GET" action="/admin/schemes">
      <div class="filter-bar">
        <input type="text" name="search" class="filter-input" placeholder="🔍 Search schemes..." value="<%= search %>" style="flex:1;min-width:200px;">
        <select name="category" class="filter-input">
          <option value="">All Categories</option>
          <option value="SC" <%=category==='SC'?'selected':''%>>SC</option>
          <option value="ST" <%=category==='ST'?'selected':''%>>ST</option>
          <option value="OBC" <%=category==='OBC'?'selected':''%>>OBC</option>
          <option value="Minority" <%=category==='Minority'?'selected':''%>>Minority</option>
          <option value="Women" <%=category==='Women'?'selected':''%>>Women</option>
          <option value="General" <%=category==='General'?'selected':''%>>General</option>
        </select>
        <button type="submit" class="btn-add" style="background:var(--navy-600);color:var(--white);">Filter</button>
        <a href="/admin/schemes" class="btn-add" style="background:transparent;border:1px solid var(--navy-600);color:var(--grey-300);">Clear</a>
      </div>
    </form>

    <div class="schemes-table">
      <div class="table-head">
        <div>Scheme</div>
        <div>Ministry</div>
        <div>Category</div>
        <div>Benefit</div>
        <div>Status</div>
        <div>Actions</div>
      </div>

      <% if (schemes.length === 0) { %>
        <div class="empty-state">
          <div style="font-size:2rem;margin-bottom:12px;">📭</div>
          <div>No schemes found. <a href="/admin/schemes/new" style="color:var(--gold);">Add one now →</a></div>
        </div>
      <% } %>

      <% schemes.forEach(s => { %>
      <div class="table-row">
        <div>
          <div class="scheme-title"><%= s.title %></div>
          <div class="scheme-min"><%= (s.scheme_code||'').substring(0,20) %></div>
        </div>
        <div style="font-size:0.78rem;color:var(--grey-500);"><%= (s.ministry||'').substring(0,30) %><%= s.ministry&&s.ministry.length>30?'...':'' %></div>
        <div>
          <% (s.category||[]).slice(0,3).forEach(c=>{ %><span class="cat-chip"><%= c %></span> <% }) %>
        </div>
        <div style="font-size:0.78rem;color:var(--white);"><%= (s.benefit_type||'').substring(0,18) %></div>
        <div>
          <% if (s.is_active) { %><span class="status-on">● Active</span><% } else { %><span class="status-off">● Off</span><% } %>
        </div>
        <div class="action-btns">
          <a href="/admin/schemes/<%= s.id %>/edit" class="btn-edit">Edit</a>
          <form action="/admin/schemes/<%= s.id %>/toggle" method="POST" style="display:inline;">
            <button type="submit" class="btn-toggle"><%= s.is_active?'Off':'On' %></button>
          </form>
          <form action="/admin/schemes/<%= s.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete this scheme?');">
            <button type="submit" class="btn-del">✕</button>
          </form>
        </div>
      </div>
      <% }) %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
    <div class="pagination">
      <% if (page > 1) { %><a href="?page=<%=page-1%>&search=<%=search%>&category=<%=category%>" class="pg-btn">← Prev</a><% } %>
      <% for(let i=1;i<=totalPages;i++){ %><a href="?page=<%=i%>&search=<%=search%>&category=<%=category%>" class="pg-btn <%=i===page?'active':''%>"><%=i%></a><% } %>
      <% if (page < totalPages) { %><a href="?page=<%=page+1%>&search=<%=search%>&category=<%=category%>" class="pg-btn">Next →</a><% } %>
    </div>
    <% } %>
  </main>
</div>
</body>
</html>
