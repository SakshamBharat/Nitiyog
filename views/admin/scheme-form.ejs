<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/nitiyog.css">
  <style>
    .admin-shell { min-height:100vh; }
    .admin-sidebar { background:var(--navy-900); padding:28px 16px; display:flex; flex-direction:column; gap:4px; position:fixed; left:0; top:0; bottom:0; width:220px; overflow-y:auto; }
    .admin-main { margin-left:220px; padding:32px 36px 60px; }
    .form-card { background:var(--navy-700); border:1px solid var(--navy-600); border-radius:16px; padding:32px; max-width:820px; }
    .form-grid { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
    .form-full { grid-column:1/-1; }
    .form-group { margin-bottom:0; }
    .form-label { display:block; font-size:0.82rem; font-weight:500; color:var(--grey-300); margin-bottom:7px; }
    .form-control { width:100%; background:var(--navy-800); border:1.5px solid var(--navy-600); border-radius:8px; padding:11px 14px; color:var(--white); font-family:'Inter',sans-serif; font-size:0.9rem; outline:none; transition:border-color 0.2s; }
    .form-control:focus { border-color:var(--gold); }
    textarea.form-control { min-height:100px; resize:vertical; }
    .hint { font-size:0.75rem; color:var(--grey-700); margin-top:5px; }
    .form-actions { display:flex; gap:12px; margin-top:28px; }
    .btn-save { background:var(--gold); color:var(--navy-900); border:none; border-radius:8px; padding:12px 28px; font-size:0.95rem; font-weight:700; cursor:pointer; font-family:'Inter',sans-serif; }
    .btn-cancel { background:transparent; border:1.5px solid var(--navy-600); color:var(--grey-300); border-radius:8px; padding:12px 24px; font-size:0.9rem; cursor:pointer; font-family:'Inter',sans-serif; text-decoration:none; display:inline-flex; align-items:center; }
    .section-divider { font-size:0.78rem; font-weight:600; color:var(--gold); letter-spacing:0.08em; text-transform:uppercase; margin:24px 0 14px; grid-column:1/-1; border-bottom:1px solid var(--navy-600); padding-bottom:8px; }
    .alert-error { background:rgba(255,92,92,0.1); border:1px solid rgba(255,92,92,0.3); color:var(--error); border-radius:8px; padding:12px 16px; margin-bottom:20px; font-size:0.88rem; }
    .toggle-label { display:flex; align-items:center; gap:10px; cursor:pointer; font-size:0.88rem; color:var(--grey-300); }
    .toggle-label input { width:18px; height:18px; accent-color:var(--gold); cursor:pointer; }
  </style>
</head>
<body>
<div class="admin-shell">
  <nav class="admin-sidebar">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:28px;">
      <div style="width:34px;height:34px;background:var(--gold);border-radius:10px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:0.9rem;color:var(--navy-900);">N</div>
      <div style="font-family:'Syne',sans-serif;font-weight:700;font-size:1rem;">Niti<span style="color:var(--gold);">yog</span> <span style="font-size:0.65rem;color:var(--grey-700);">ADMIN</span></div>
    </div>
    <a href="/admin" class="nav-item"><span class="nav-icon">📊</span> Dashboard</a>
    <a href="/admin/schemes" class="nav-item"><span class="nav-icon">📋</span> Manage Schemes</a>
    <a href="/admin/schemes/new" class="nav-item active"><span class="nav-icon">➕</span> Add Scheme</a>
    <a href="/admin/users" class="nav-item"><span class="nav-icon">👥</span> Users</a>
    <div style="margin-top:auto;padding-top:20px;border-top:1px solid var(--navy-700);">
      <a href="/logout" class="nav-item" style="color:var(--error);"><span class="nav-icon">🚪</span> Logout</a>
    </div>
  </nav>

  <main class="admin-main">
    <div style="margin-bottom:24px;">
      <h1 style="font-size:1.4rem;font-weight:700;margin-bottom:4px;"><%= scheme ? 'Edit Scheme' : 'Add New Scheme' %></h1>
      <p style="color:var(--grey-500);font-size:0.85rem;">Fill all details carefully. Arrays = comma-separated values.</p>
    </div>

    <% if (error) { %><div class="alert-error">❌ <%= error %></div><% } %>

    <% const action = scheme && scheme.id ? '/admin/schemes/'+scheme.id+'/edit' : '/admin/schemes/new' %>
    <% const val = (key) => scheme && scheme[key] ? (Array.isArray(scheme[key]) ? scheme[key].join(', ') : scheme[key]) : '' %>

    <form action="<%= action %>" method="POST" class="form-card">
      <div class="form-grid">

        <div class="section-divider">Basic Information</div>

        <div class="form-group form-full">
          <label class="form-label">Scheme Title *</label>
          <input type="text" name="title" class="form-control" value="<%- val('title') %>" placeholder="e.g. PM Vishwakarma Yojana" required>
        </div>

        <div class="form-group">
          <label class="form-label">Scheme Code</label>
          <input type="text" name="scheme_code" class="form-control" value="<%- val('scheme_code') %>" placeholder="e.g. PM-VISHWAKARMA-2023">
          <div class="hint">Unique identifier. Auto-generated if left blank.</div>
        </div>

        <div class="form-group">
          <label class="form-label">Scheme URL</label>
          <input type="url" name="scheme_url" class="form-control" value="<%- val('scheme_url') %>" placeholder="https://...">
        </div>

        <div class="form-group form-full">
          <label class="form-label">Ministry *</label>
          <input type="text" name="ministry" class="form-control" value="<%- val('ministry') %>" placeholder="e.g. Ministry of Social Justice and Empowerment (MoSJE)" required>
        </div>

        <div class="form-group form-full">
          <label class="form-label">Department</label>
          <input type="text" name="department" class="form-control" value="<%- val('department') %>" placeholder="e.g. KVIC, NSFDC, SIDBI">
        </div>

        <div class="section-divider">Eligibility</div>

        <div class="form-group">
          <label class="form-label">Category (comma-separated) *</label>
          <input type="text" name="category" class="form-control" value="<%- val('category') %>" placeholder="SC, ST, OBC, Minority, Women, General">
          <div class="hint">Who is eligible? Use: SC, ST, OBC, Minority, Women, General</div>
        </div>

        <div class="form-group">
          <label class="form-label">State(s) (comma-separated)</label>
          <input type="text" name="state" class="form-control" value="<%- val('state') %>" placeholder="All India, Uttar Pradesh, Maharashtra">
          <div class="hint">Use "All India" for central schemes</div>
        </div>

        <div class="form-group">
          <label class="form-label">Gender</label>
          <input type="text" name="gender" class="form-control" value="<%- val('gender') %>" placeholder="Male, Female, Transgender">
        </div>

        <div class="form-group">
          <label class="form-label">Business Type</label>
          <input type="text" name="business_type" class="form-control" value="<%- val('business_type') %>" placeholder="Manufacturing, Trade, Services, Agriculture">
        </div>

        <div class="form-group">
          <label class="form-label">Min Age</label>
          <input type="number" name="min_age" class="form-control" value="<%- val('min_age') %>" placeholder="18">
        </div>

        <div class="form-group">
          <label class="form-label">Max Age</label>
          <input type="number" name="max_age" class="form-control" value="<%- val('max_age') %>" placeholder="Leave blank if no limit">
        </div>

        <div class="form-group form-full">
          <label class="form-label">Max Annual Income (₹)</label>
          <input type="number" name="max_income" class="form-control" value="<%- val('max_income') %>" placeholder="300000 (leave blank if no income limit)">
          <div class="hint">Enter in Rupees. e.g. 300000 = ₹3 Lakh</div>
        </div>

        <div class="section-divider">Benefit Details</div>

        <div class="form-group">
          <label class="form-label">Benefit Type *</label>
          <select name="benefit_type" class="form-control" required>
            <option value="">Select type</option>
            <% ['Grant','Loan','Subsidy','Grant + Loan','Loan + Subsidy','Micro Loan','Collateral-free Loan','Training + Loan','Venture Capital'].forEach(t=>{ %>
            <option value="<%=t%>" <%=(val('benefit_type')===t)?'selected':''%>><%=t%></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Application Deadline</label>
          <input type="date" name="deadline" class="form-control" value="<%- val('deadline') ? val('deadline').toString().substring(0,10) : '' %>">
          <div class="hint">Leave blank for ongoing schemes</div>
        </div>

        <div class="form-group form-full">
          <label class="form-label">Benefit Amount *</label>
          <input type="text" name="benefit_amount" class="form-control" value="<%- val('benefit_amount') %>" placeholder="e.g. ₹3,00,000 credit support + ₹15,000 toolkit grant" required>
        </div>

        <div class="section-divider">Descriptions</div>

        <div class="form-group form-full">
          <label class="form-label">Short Description *</label>
          <textarea name="description" class="form-control" placeholder="Brief description of the scheme..." required><%- val('description') %></textarea>
        </div>

        <div class="form-group form-full">
          <label class="form-label">Eligibility Criteria</label>
          <textarea name="eligibility" class="form-control" placeholder="Who is eligible? What are the conditions?"><%- val('eligibility') %></textarea>
        </div>

        <div class="form-group form-full">
          <label class="form-label">How to Apply</label>
          <textarea name="how_to_apply" class="form-control" placeholder="Step-by-step application process..."><%- val('how_to_apply') %></textarea>
        </div>

        <div class="form-group form-full">
          <label class="form-label">Documents Required (comma-separated)</label>
          <input type="text" name="documents" class="form-control" value="<%- val('documents') %>" placeholder="Aadhaar Card, PAN Card, Caste Certificate, Bank Passbook">
        </div>

        <div class="form-group form-full">
          <label class="toggle-label">
            <input type="checkbox" name="is_active" <%=(scheme && scheme.is_active !== false)?'checked':(!scheme?'checked':'')%>>
            Active (visible to users on dashboard)
          </label>
        </div>

      </div><!-- /form-grid -->

      <div class="form-actions">
        <button type="submit" class="btn-save">💾 <%= scheme ? 'Update Scheme' : 'Save Scheme' %></button>
        <a href="/admin/schemes" class="btn-cancel">Cancel</a>
      </div>
    </form>
  </main>
</div>
</body>
</html>
