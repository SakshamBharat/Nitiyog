<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Entrepreneur Dashboard - NitiYog</title>
  <link rel="stylesheet" href="/css/nitiyog.css">
</head>
<body>

  <header class="app-header">
    <div class="brand-logo">
      <div class="brand-logo-mark">N</div>
      <div class="brand-logo-text">Niti<span>yog</span></div>
    </div>
    <div>
      <span>Welcome, <strong><%= user ? user.name : 'Entrepreneur' %></strong></span>
      <a href="/logout" style="color:#ef4444; margin-left:16px; text-decoration:none;">Logout</a>
    </div>
  </header>

  <div class="app-container">
    
    <!-- User Profile Summary Card -->
    <div class="card">
      <h2>Your Registered Profile Criteria</h2>
      <p class="section-desc">Profile details used to match with official Scheme parameters.</p>
      
      <% if (user && user.Profile) { %>
        <div class="grid-3" style="margin-top:12px;">
          <div><strong>Category:</strong> <%= user.Profile.category %></div>
          <div><strong>State:</strong> <%= user.Profile.state %></div>
          <div><strong>Gender / Age:</strong> <%= user.Profile.gender %> (<%= user.Profile.age %> yrs)</div>
          <div><strong>Income:</strong> ₹<%= user.Profile.annualIncome %></div>
          <div><strong>Enterprise:</strong> <%= user.Profile.enterpriseType %></div>
          <div><strong>Turnover:</strong> ₹<%= user.Profile.turnover %></div>
        </div>
      <% } else { %>
        <p style="color:var(--text-muted); margin-top:8px;">No profile details found. Complete your profile setup.</p>
      <% } %>
    </div>

    <!-- Active Matched Schemes Table -->
    <div class="card">
      <h2>Eligible Schemes Matched For You</h2>
      <p class="section-desc">Schemes matching your target category and funding eligibility.</p>

      <table class="table">
        <thead>
          <tr>
            <th>Scheme Title</th>
            <th>Ministry</th>
            <th>Max Funding</th>
            <th>Target Category</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof schemes !== 'undefined' && schemes.length > 0) { %>
            <% schemes.forEach(scheme => { %>
              <tr>
                <td><strong><%= scheme.title %></strong></td>
                <td><%= scheme.ministry %></td>
                <td>₹<%= scheme.maxFunding %></td>
                <td><%= scheme.targetCategory ? scheme.targetCategory.join(', ') : 'All' %></td>
                <td>
                  <a href="/scheme/<%= scheme.id %>" class="btn btn-primary" style="padding: 4px 8px;">View & Apply</a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" style="text-align:center; color:var(--text-muted);">No matched schemes currently stored in database.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Application Tracking Card -->
    <div class="card">
      <h2>Your Applications Tracking</h2>
      <p class="section-desc">Status of auto-generated draft forms and submissions.</p>

      <table class="table">
        <thead>
          <tr>
            <th>Application ID</th>
            <th>Scheme Name</th>
            <th>Status</th>
            <th>Prefilled Form</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof applications !== 'undefined' && applications.length > 0) { %>
            <% applications.forEach(app => { %>
              <tr>
                <td><%= app.id.substring(0, 8) %>...</td>
                <td><%= app.Scheme ? app.Scheme.title : 'N/A' %></td>
                <td><span class="badge badge-user"><%= app.status %></span></td>
                <td>
                  <% if (app.prefilledDocPath) { %>
                    <a href="<%= app.prefilledDocPath %>" target="_blank" class="gold-link">Download PDF</a>
                  <% } else { %>
                    Not Generated
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="4" style="text-align:center; color:var(--text-muted);">No active scheme applications found.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>


    <div class="scheme-grid">
  <% if (matchedSchemes && matchedSchemes.length > 0) { %>
    <% matchedSchemes.forEach(item => { %>
      <div class="scheme-card matched">
        <span class="badge badge-success">98% Match</span>
        <h3><%= item.scheme.title %></h3>
        <p><%= item.scheme.description %></p>
        
        <div class="scheme-meta">
          <span><strong>Subsidy / Benefit:</strong> <%= item.scheme.subsidyAmount || 'As per norms' %></span>
          <span><strong>Category:</strong> <%= item.scheme.targetCategory %></span>
        </div>

        <button onclick="applyForScheme('<%= item.scheme.id %>')" class="btn btn-primary">
          Apply Now
        </button>
      </div>
    <% }) %>
  <% } else { %>
    <div class="empty-state">
      <p>No matching schemes found for your current profile. Try updating your profile details.</p>
    </div>
  <% } %>
</div>

  </div>

</body>
</html>