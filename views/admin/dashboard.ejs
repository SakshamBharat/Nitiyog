<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/nitiyog.css">
  <style>
    .admin-shell { min-height:100vh; }
    .admin-sidebar { background:var(--navy-900); padding:28px 16px; display:flex; flex-direction:column; gap:4px; position:fixed; left:0; top:0; bottom:0; width:220px; overflow-y:auto; }
    .admin-main { margin-left:220px; padding:32px 36px; }
    .admin-topbar { display:flex; align-items:center; justify-content:space-between; margin-bottom:32px; }
    .admin-topbar h1 { font-size:1.4rem; font-weight:700; }
    .admin-badge { background:rgba(204,120,92,0.15); color:var(--gold); border:1px solid rgba(204,120,92,0.3); padding:3px 12px; border-radius:100px; font-size:0.75rem; font-weight:600; }
    .stat-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-bottom:36px; }
    .admin-stat { background:var(--navy-700); border:1px solid var(--navy-600); border-radius:16px; padding:28px; }
    .admin-stat .icon { font-size:1.8rem; margin-bottom:12px; }
    .admin-stat .val { font-family:'Cormorant Garamond', Georgia, serif; font-size:2.2rem; font-weight:700; margin-bottom:4px; }
    .admin-stat .lbl { font-size:0.82rem; color:var(--grey-500); }
    .quick-links { display:grid; grid-template-columns:repeat(2,1fr); gap:16px; }
    .qlink { background:var(--navy-700); border:1px solid var(--navy-600); border-radius:14px; padding:24px; text-decoration:none; display:flex; align-items:center; gap:16px; transition:all 0.2s; }
    .qlink:hover { border-color:var(--gold); transform:translateY(-2px); }
    .qlink .ql-icon { font-size:1.8rem; }
    .qlink h3 { font-size:0.98rem; color:var(--white); margin-bottom:4px; }
    .qlink p { font-size:0.8rem; color:var(--grey-500); margin:0; }
    .api-box { background:var(--navy-700); border:1px solid var(--navy-600); border-radius:14px; padding:24px; margin-top:20px; }
    .api-box h3 { margin-bottom:8px; font-size:1rem; }
    .api-box p { font-size:0.85rem; color:var(--grey-500); margin-bottom:16px; }
    .api-row { display:flex; gap:10px; }
    .api-input { flex:1; background:var(--navy-800); border:1.5px solid var(--navy-600); border-radius:8px; padding:10px 14px; color:var(--white); font-size:0.9rem; font-family:'Inter',sans-serif; outline:none; }
    .api-input:focus { border-color:var(--gold); }
    .btn-sm { background:var(--gold); color:var(--navy-900); border:none; border-radius:8px; padding:10px 20px; font-size:0.88rem; font-weight:600; cursor:pointer; font-family:'Inter',sans-serif; white-space:nowrap; }
  </style>
</head>
<body>
<div class="admin-shell">
  <!-- Sidebar -->
  <nav class="admin-sidebar">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:28px;">
      <div style="width:34px;height:34px;background:var(--gold);border-radius:10px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.9rem;color:var(--navy-900);">N</div>
      <div style="font-family:'Cormorant Garamond', Georgia, serif;font-weight:700;font-size:1rem;">Niti<span style="color:var(--gold);">yog</span> <span style="font-size:0.65rem;color:var(--grey-700);">ADMIN</span></div>
    </div>
    <span style="font-size:0.7rem;color:var(--grey-700);letter-spacing:0.1em;text-transform:uppercase;padding:12px 10px 6px;font-weight:600;">Panel</span>
    <a href="/admin" class="nav-item active"><span class="nav-icon">📊</span> Dashboard</a>
    <a href="/admin/schemes" class="nav-item"><span class="nav-icon">📋</span> Manage Schemes</a>
    <a href="/admin/schemes/new" class="nav-item"><span class="nav-icon">➕</span> Add Scheme</a>
    <a href="/admin/users" class="nav-item"><span class="nav-icon">👥</span> Users</a>
    <div style="margin-top:auto;padding-top:20px;border-top:1px solid var(--navy-700);">
      <div style="font-size:0.82rem;font-weight:500;color:var(--white);margin-bottom:2px;padding:8px 10px;"><%= admin.fname %> <%= admin.lname %></div>
      <a href="/logout" class="nav-item" style="color:var(--error);"><span class="nav-icon">🚪</span> Logout</a>
    </div>
  </nav>

  <!-- Main -->
  <main class="admin-main">
    <div class="admin-topbar">
      <div>
        <h1>Admin Dashboard</h1>
        <p style="color:var(--grey-500);font-size:0.85rem;margin-top:4px;">Manage Nitiyog schemes, users, and data</p>
      </div>
      <span class="admin-badge">🔧 Admin Mode</span>
    </div>

    <div class="stat-grid">
      <div class="admin-stat">
        <div class="icon">📋</div>
        <div class="val" style="color:var(--gold);"><%= stats.schemes %></div>
        <div class="lbl">Active Schemes</div>
      </div>
      <div class="admin-stat">
        <div class="icon">👥</div>
        <div class="val"><%= stats.users %></div>
        <div class="lbl">Registered Users</div>
      </div>
      <div class="admin-stat">
        <div class="icon">📝</div>
        <div class="val" style="color:var(--emerald);"><%= stats.apps %></div>
        <div class="lbl">Applications Submitted</div>
      </div>
    </div>

    <div class="quick-links">
      <a href="/admin/schemes/new" class="qlink">
        <div class="ql-icon">➕</div>
        <div><h3>Add New Scheme</h3><p>Manually add a government scheme</p></div>
      </a>
      <a href="/admin/schemes" class="qlink">
        <div class="ql-icon">✏️</div>
        <div><h3>Edit Schemes</h3><p>View, edit, activate/deactivate</p></div>
      </a>
      <a href="/admin/users" class="qlink">
        <div class="ql-icon">👥</div>
        <div><h3>View Users</h3><p>See registered entrepreneurs</p></div>
      </a>
      <a href="/home" class="qlink">
        <div class="ql-icon">🏠</div>
        <div><h3>View as User</h3><p>See the public dashboard</p></div>
      </a>
    </div>

    <!-- MyScheme API Fetch -->
    <div class="api-box">
      <h3>🌐 Fetch from MyScheme.gov.in API</h3>
      <p>Enter a keyword to search and import schemes directly from India's official government scheme portal.</p>
      <form action="/admin/fetch-api" method="POST">
        <div class="api-row">
          <input type="text" name="keyword" class="api-input" placeholder="e.g. SC entrepreneur, women loan, minority, MSME..." required>
          <button type="submit" class="btn-sm">Fetch Schemes →</button>
        </div>
      </form>
    </div>
  </main>
</div>
</body>
</html>
