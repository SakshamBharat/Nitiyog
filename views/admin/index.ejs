<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >

  <title>NitiYog Admin Dashboard</title>

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="/css/app.css"
  >

</head>


<body class="admin-body">


<header class="admin-navbar">

  <div class="brand">

    <div class="brand-logo">
      N
    </div>

    <div>

      <strong>
        Niti<span>yog</span>
      </strong>

      <small>
        Administration
      </small>

    </div>

  </div>


  <div class="admin-user">

    <span>
      <%= user.email %>
    </span>

    <button
      onclick="logout()"
      class="logout-button"
    >
      Logout
    </button>

  </div>

</header>


<main class="admin-container">

  <div class="admin-heading">

    <div>

      <span class="eyebrow-dark">
        Administration
      </span>

      <h1>
        Platform overview
      </h1>

      <p>
        Manage citizens, schemes and applications.
      </p>

    </div>

  </div>


  <section class="stats-grid">

    <div class="stat-card">

      <span>
        Registered Citizens
      </span>

      <strong>
        <%= stats.users %>
      </strong>

      <small>
        Active citizen accounts
      </small>

    </div>


    <div class="stat-card">

      <span>
        Government Schemes
      </span>

      <strong>
        <%= stats.schemes %>
      </strong>

      <small>
        Scheme records
      </small>

    </div>


    <div class="stat-card">

      <span>
        Applications
      </span>

      <strong>
        <%= stats.applications %>
      </strong>

      <small>
        Citizen applications
      </small>

    </div>

  </section>


  <section class="admin-panels">

    <div class="admin-panel">

      <div class="panel-icon">
        👥
      </div>

      <h3>
        Citizen management
      </h3>

      <p>
        View users, account status and
        verification information.
      </p>

      <button>
        Manage citizens →
      </button>

    </div>


    <div class="admin-panel">

      <div class="panel-icon">
        📋
      </div>

      <h3>
        Scheme management
      </h3>

      <p>
        Add government schemes and
        configure eligibility criteria.
      </p>

      <button>
        Manage schemes →
      </button>

    </div>


    <div class="admin-panel">

      <div class="panel-icon">
        📊
      </div>

      <h3>
        Applications
      </h3>

      <p>
        Review and update citizen
        application statuses.
      </p>

      <button>
        View applications →
      </button>

    </div>

  </section>

  <section class="admin-scheme-import">
    <form id="schemePdfForm" class="admin-scheme-form admin-pdf-form" enctype="multipart/form-data">
      <label class="wide">Select a government scheme PDF
        <input name="schemePdf" type="file" accept="application/pdf" />
      </label>
      <label class="wide">Or fetch PDF from an official government URL
        <input name="pdfUrl" type="url" placeholder="https://...gov.in/scheme.pdf" />
      </label>
      <label>Application link<input name="applicationUrl" type="url" placeholder="https://...gov.in/apply" /></label>
      <label>Source portal<input name="sourceUrl" type="url" value="https://www.myscheme.gov.in/" required /></label>
      <label class="publish-toggle"><input name="status" type="checkbox" value="PUBLISHED" checked /> Publish after scan</label>
      <button class="button primary" type="submit">Scan PDF and store scheme</button>
      <p id="schemePdfMessage" class="admin-form-message" role="status"></p>
    </form>

    <form id="officialSyncForm" class="admin-scheme-form">
      <label>Official portal batch size
        <input name="limit" type="number" min="1" max="25" value="5" />
      </label>
      <button class="button primary" type="submit">Sync official scheme batch</button>
      <p id="officialSyncMessage" class="admin-form-message" role="status"></p>
    </form>
  </section>

</main>


<script>

async function logout() {

  await fetch(
    "/api/auth/logout",
    {
      method: "POST"
    }
  );

  window.location.href =
    "/admin/login";
}

document.getElementById("schemePdfForm").addEventListener("submit", async (event) => {
  event.preventDefault();
  const form = event.currentTarget;
  const message = document.getElementById("schemePdfMessage");
  const data = new FormData(form);
  const file = form.elements.schemePdf.files[0];
  const pdfUrl = form.elements.pdfUrl.value.trim();
  if (!file && !pdfUrl) {
    message.textContent = "Select a PDF or provide an official government PDF URL.";
    return;
  }
  data.set("status", form.elements.status.checked ? "PUBLISHED" : "DRAFT");
  message.textContent = "Sarthak AI is scanning the PDF and saving the scheme...";
  try {
    const response = await fetch("/admin/schemes/upload-pdf", { method: "POST", body: data });
    const payload = await response.json();
    if (!response.ok) throw new Error(payload.error || "Unable to scan PDF.");
    message.textContent = `Stored ${payload.scheme.name} successfully.`;
    form.reset();
  } catch (error) {
    message.textContent = error.message;
  }
});

document.getElementById("officialSyncForm").addEventListener("submit", async (event) => {
  event.preventDefault();
  const form = event.currentTarget;
  const message = document.getElementById("officialSyncMessage");
  message.textContent = "Scanning official portal URLs with Sarthak AI...";
  try {
    const response = await fetch("/admin/schemes/sync-official", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ limit: Number(form.elements.limit.value) })
    });
    const payload = await response.json();
    if (!response.ok) throw new Error(payload.error || "Official sync failed.");
    message.textContent = `Discovered ${payload.discovered}; imported ${payload.imported}.`;
  } catch (error) {
    console.error("Official scheme sync failed:", error);
    message.textContent = error.message;
  }
});

</script>

</body>
</html>
